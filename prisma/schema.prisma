// Prisma schema for taxap.
// Conventions (docs/data-model.md):
//  - PKs: UUID, native uuidv7() (PostgreSQL 18+, no extension).
//  - Money: DECIMAL(14,2), never float.
//  - Tax dates: DATE, no timezone.
//  - Columns are snake_case in Postgres (@map), camelCase in Prisma/TS.
//  - RLS: see prisma/migrations/*_add_rls and docs/adr/004-rls-por-usuario-con-prisma.md

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// Identity and access
// ============================================================================

model User {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  role         UserRole @default(INDIVIDUAL)
  planCode     String   @default("STARTER") @map("plan_code")
  aiEnabled    Boolean  @default(true) @map("ai_enabled")
  createdAt    DateTime @default(now()) @map("created_at")

  plan                 Plan                  @relation(fields: [planCode], references: [code])
  userTaxpayers        UserTaxpayer[]
  classificationEvents ClassificationEvent[]
  sourceFiles          SourceFile[]
  formVersionsImported FormVersion[]
  aiUsage              AiUsage[]
  taxpayersCreated     Taxpayer[]
  taxRatesLoaded       TaxRate[]

  @@map("users")
}

enum UserRole {
  INDIVIDUAL
  ACCOUNTANT
  ADMIN
}

/// Plans: two limits (taxpayers, users). The second is 1 today across
/// all plans, but the column exists (ADR-003).
model Plan {
  code         String  @id
  maxTaxpayers Int     @map("max_taxpayers")
  maxUsers     Int     @default(1) @map("max_users")
  aiIncluded   Boolean @default(true) @map("ai_included")

  users User[]

  @@map("plans")
}

/// A join table from day one, even though today each taxpayer has
/// exactly one row (ADR-003).
model UserTaxpayer {
  id         String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  taxpayerId String         @map("taxpayer_id") @db.Uuid
  access     TaxpayerAccess @default(OWNER)
  createdAt  DateTime       @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taxpayer Taxpayer @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)

  @@unique([userId, taxpayerId])
  @@index([userId])
  @@index([taxpayerId])
  @@map("user_taxpayers")
}

enum TaxpayerAccess {
  OWNER
  COLLABORATOR
}

// ============================================================================
// Taxpayers and periods
// ============================================================================

model Taxpayer {
  id                  String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ruc                 String      @unique
  businessName        String      @map("business_name")
  tradeName           String?     @map("trade_name")
  regime              TaxRegime   @default(GENERAL)
  ivaPeriodicity      Periodicity @default(MONTHLY) @map("iva_periodicity")
  economicActivities  Json        @default("[]") @map("economic_activities") // [{code, description}]
  activityFingerprint String      @map("activity_fingerprint")
  // Who created it -- not in data-model.md, added because Prisma's
  // .create() always does INSERT ... RETURNING, and Postgres filters
  // RETURNING through the SELECT policy: without this, the creator can't
  // see the row they just inserted until the link exists in
  // user_taxpayers (created in the next statement, not the same one).
  createdBy           String      @map("created_by") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at")

  creator          User              @relation(fields: [createdBy], references: [id])
  userTaxpayers    UserTaxpayer[]
  taxPeriods       TaxPeriod[]
  supplierRules    SupplierRule[]
  invoicesReceived InvoiceReceived[]
  invoicesIssued   InvoiceIssued[]
  sourceFiles      SourceFile[]
  aiUsage          AiUsage[]

  @@index([ruc])
  @@map("taxpayers")
}

enum TaxRegime {
  RIMPE_POPULAR
  RIMPE_EMPRENDEDOR
  GENERAL
}

enum Periodicity {
  MONTHLY
  SEMIANNUAL
  ANNUAL
}

model TaxPeriod {
  id                    String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taxpayerId            String       @map("taxpayer_id") @db.Uuid
  taxType               TaxType      @default(IVA) @map("tax_type")
  periodStart           DateTime     @map("period_start") @db.Date
  periodEnd             DateTime     @map("period_end") @db.Date
  periodicity           Periodicity  @default(MONTHLY)
  status                PeriodStatus @default(DRAFT)
  formVersionId         String?      @map("form_version_id") @db.Uuid
  proportionalityFactor Decimal?     @map("proportionality_factor") @db.Decimal(5, 4)
  factorInputs          Json?        @map("factor_inputs")
  filedAt               DateTime?    @map("filed_at")
  lockedAt              DateTime?    @map("locked_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  taxpayer    Taxpayer     @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  formVersion FormVersion? @relation(fields: [formVersionId], references: [id])

  invoicesReceived     InvoiceReceived[]
  invoicesIssued       InvoiceIssued[]
  periodResults        PeriodResult[]
  sourceFiles          SourceFile[]
  classificationEvents ClassificationEvent[]

  @@unique([taxpayerId, taxType, periodStart])
  @@index([taxpayerId])
  @@index([status])
  @@map("tax_periods")
}

enum TaxType {
  IVA
  INCOME_TAX
  WITHHOLDING
}

enum PeriodStatus {
  DRAFT
  UNDER_REVIEW
  FILED
}

model SourceFile {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taxpayerId   String     @map("taxpayer_id") @db.Uuid
  taxPeriodId  String?    @map("tax_period_id") @db.Uuid
  kind         SourceKind
  filename     String
  sha256       String
  rowCount     Int        @default(0) @map("row_count")
  rowsImported Int        @default(0) @map("rows_imported")
  rowsRejected Int        @default(0) @map("rows_rejected")
  uploadedBy   String     @map("uploaded_by") @db.Uuid
  uploadedAt   DateTime   @default(now()) @map("uploaded_at")

  taxpayer         Taxpayer          @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  taxPeriod        TaxPeriod?        @relation(fields: [taxPeriodId], references: [id], onDelete: SetNull)
  uploader         User              @relation(fields: [uploadedBy], references: [id])
  invoicesReceived InvoiceReceived[]
  invoicesIssued   InvoiceIssued[]

  @@index([taxpayerId])
  @@index([sha256])
  @@map("source_files")
}

enum SourceKind {
  PURCHASES_TXT
  SALES_TXT
}

// ============================================================================
// Vouchers
// ============================================================================

/// Reflects the SRI file's columns, without inventing fields (ADR-008).
model InvoiceReceived {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taxpayerId   String  @map("taxpayer_id") @db.Uuid
  taxPeriodId  String  @map("tax_period_id") @db.Uuid
  sourceFileId String? @map("source_file_id") @db.Uuid

  accessKey         String    @map("access_key") @db.Char(49)
  supplierRuc       String    @map("supplier_ruc")
  supplierName      String    @map("supplier_name")
  documentType      String    @map("document_type")
  series            String
  issueDate         DateTime  @map("issue_date") @db.Date
  authorizationDate DateTime? @map("authorization_date")
  subtotal          Decimal   @db.Decimal(14, 2)
  vatAmount         Decimal   @map("vat_amount") @db.Decimal(14, 2)
  total             Decimal   @db.Decimal(14, 2)
  modifiedDocument  String?   @map("modified_document")

  // Classification (ADR-005, ADR-006)
  ivaCategory          IvaCategory               @default(UNCLASSIFIED) @map("iva_category")
  processingStatus     ProcessingStatus          @default(UNCLASSIFIED) @map("processing_status")
  classificationSource ClassificationSourceType? @map("classification_source")
  appliedRuleId        String?                   @map("applied_rule_id") @db.Uuid
  aiConfidence         Decimal?                  @map("ai_confidence") @db.Decimal(3, 2)
  aiReasoning          String?                   @map("ai_reasoning")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  taxpayer   Taxpayer    @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  taxPeriod  TaxPeriod   @relation(fields: [taxPeriodId], references: [id], onDelete: Cascade)
  sourceFile SourceFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  @@unique([taxpayerId, accessKey])
  @@index([taxpayerId, taxPeriodId, processingStatus])
  @@index([taxpayerId, supplierRuc])
  @@map("invoices_received")
}

enum IvaCategory {
  CREDIT // 500: with right to credit
  COST_EXPENSE // 502: no right to credit
  NON_DEDUCTIBLE // not deductible (outside the business)
  NOT_APPLICABLE // IVA = 0, doesn't enter the cascade
  UNCLASSIFIED // not classified yet
}

/// PROCESSED/REQUIRES_MANUAL_REVIEW/EXCLUDED are the states documented in
/// data-model.md. UNCLASSIFIED is the initial state after ingestion,
/// before step 2 runs (ADR-011) -- the spec doesn't name it explicitly
/// but "unclassified" is exactly this.
enum ProcessingStatus {
  UNCLASSIFIED
  PROCESSED
  REQUIRES_MANUAL_REVIEW
  EXCLUDED
}

enum ClassificationSourceType {
  RULE
  CATALOG
  AI
  USER
  DETERMINISTIC
}

/// The issued-vouchers file has fewer columns than the received one: it
/// carries no receiver identification or business name.
model InvoiceIssued {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taxpayerId   String  @map("taxpayer_id") @db.Uuid
  taxPeriodId  String  @map("tax_period_id") @db.Uuid
  sourceFileId String? @map("source_file_id") @db.Uuid

  accessKey         String    @map("access_key") @db.Char(49)
  documentType      String    @map("document_type") // COMPROBANTE, not TIPO_COMPROBANTE
  series            String
  issueDate         DateTime  @map("issue_date")
  authorizationDate DateTime? @map("authorization_date")
  subtotal          Decimal   @db.Decimal(14, 2)
  vatAmount         Decimal   @map("vat_amount") @db.Decimal(14, 2)
  total             Decimal   @db.Decimal(14, 2)

  salesTreatment SalesTreatment @default(UNCLASSIFIED) @map("sales_treatment")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  taxpayer   Taxpayer    @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  taxPeriod  TaxPeriod   @relation(fields: [taxPeriodId], references: [id], onDelete: Cascade)
  sourceFile SourceFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  @@unique([taxpayerId, accessKey])
  @@index([taxpayerId])
  @@index([taxPeriodId])
  @@index([issueDate])
  @@index([salesTreatment])
  @@map("invoices_issued")
}

enum SalesTreatment {
  TAXED // IVA > 0, automatic
  ZERO_NO_CREDIT // 403
  ZERO_WITH_CREDIT // 405
  EXPORT_GOODS // 407
  EXPORT_SERVICES // 408
  NON_OBJECT_EXEMPT // 431
  UNCLASSIFIED // not marked yet
}

// ============================================================================
// Classification engine
// ============================================================================

/// The rule is per taxpayer; revocable, never deleted (ADR-006).
model SupplierRule {
  id                  String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taxpayerId          String      @map("taxpayer_id") @db.Uuid
  supplierRuc         String      @map("supplier_ruc")
  activityFingerprint String      @map("activity_fingerprint")
  ivaCategory         IvaCategory @map("iva_category")
  source              RuleSource
  createdBy           String?     @map("created_by") @db.Uuid
  timesApplied        Int         @default(0) @map("times_applied")
  revokedAt           DateTime?   @map("revoked_at")
  appliedAt           DateTime    @default(now()) @map("applied_at")

  taxpayer Taxpayer @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)

  @@index([taxpayerId])
  @@map("supplier_rules")
}

enum RuleSource {
  USER
  CATALOG
  AI
}

/// Global, anonymous aggregate -- no taxpayer or user identifiers
/// (ADR-007).
model SharedSupplierCatalog {
  supplierRuc          String      @id @map("supplier_ruc")
  supplierName         String      @map("supplier_name")
  suggestedIvaCategory IvaCategory @map("suggested_iva_category")
  agreementRatio       Decimal     @map("agreement_ratio") @db.Decimal(3, 2)
  sampleCount          Int         @default(1) @map("sample_count")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  @@map("shared_supplier_catalog")
}

/// Append-only; UPDATE and DELETE are rejected by a trigger (ADR-013).
model ClassificationEvent {
  id                String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  receivedInvoiceId String? @map("received_invoice_id") @db.Uuid
  issuedInvoiceId   String? @map("issued_invoice_id") @db.Uuid
  taxpayerId        String  @map("taxpayer_id") @db.Uuid
  taxPeriodId       String  @map("tax_period_id") @db.Uuid

  field         String
  oldValue      String?                   @map("old_value")
  newValue      String?                   @map("new_value")
  actorType     ActorType                 @map("actor_type")
  actorUserId   String?                   @map("actor_user_id") @db.Uuid
  source        ClassificationSourceType?
  rulesVersion  String?                   @map("rules_version")
  modelId       String?                   @map("model_id")
  promptVersion String?                   @map("prompt_version")
  // What the model answered when it was consulted -- also kept when its
  // answer was below the acceptance bar and the voucher went to review.
  aiConfidence  Decimal?                  @map("ai_confidence") @db.Decimal(3, 2)
  aiReasoning   String?                   @map("ai_reasoning")
  reason        String?

  createdAt DateTime @default(now()) @map("created_at")

  taxPeriod TaxPeriod @relation(fields: [taxPeriodId], references: [id], onDelete: Cascade)
  actorUser User?     @relation(fields: [actorUserId], references: [id])

  @@index([taxPeriodId])
  @@index([actorUserId])
  @@map("classification_events")
}

enum ActorType {
  USER
  ENGINE
}

// ============================================================================
// Normative data
// ============================================================================

model TaxRate {
  tax       TaxRateType
  rate      Decimal     @db.Decimal(5, 4)
  validFrom DateTime    @map("valid_from") @db.Date
  validTo   DateTime?   @map("valid_to") @db.Date

  // CLAUDE.md -> "Normative values": every tax number carries a source
  // and a verification date. The schema had nowhere to store either --
  // whatever got loaded (if anything did) left no trace of where it
  // came from.
  source     String
  verifiedAt DateTime @map("verified_at") @db.Date
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  creator User @relation(fields: [createdBy], references: [id])

  @@id([tax, validFrom])
  @@map("tax_rates")
}

enum TaxRateType {
  IVA
}

// ============================================================================
// Form and its relation to results (ADR-015)
// ============================================================================

model FormVersion {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  formCode     String     @map("form_code") // "104"; the MVP only supports the monthly one
  label        String
  validFrom    DateTime   @map("valid_from") @db.Date
  validTo      DateTime?  @map("valid_to") @db.Date
  status       FormStatus @default(DRAFT)
  sourceSha256 String?    @map("source_sha256") // hash of the PDF; the file itself is never stored
  importedBy   String?    @map("imported_by") @db.Uuid
  importedAt   DateTime?  @map("imported_at")
  publishedAt  DateTime?  @map("published_at")

  importer       User?           @relation(fields: [importedBy], references: [id])
  formFields     FormField[]
  resultMappings ResultMapping[]
  taxPeriods     TaxPeriod[]

  @@unique([formCode, validFrom])
  @@index([status])
  @@map("form_versions")
}

enum FormStatus {
  DRAFT
  PUBLISHED
}

/// The form's complete catalog, exactly as it comes out of the PDF. No
/// values, no formulas, no personal data.
model FormField {
  id            String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  formVersionId String     @map("form_version_id") @db.Uuid
  code          String // "500", "563"...
  label         String
  section       String?
  columnKind    ColumnKind @default(SINGLE) @map("column_kind")
  displayOrder  Int        @map("display_order")
  observed      Boolean    @default(true) // false if a later import didn't find it

  formVersion    FormVersion     @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  resultMappings ResultMapping[]

  @@unique([formVersionId, code])
  @@index([formVersionId])
  @@map("form_fields")
}

enum ColumnKind {
  GROSS
  NET
  TAX
  SINGLE
}

/// Which field receives each result, computed once per version and
/// stored. Nobody edits these rows by hand.
model ResultMapping {
  formVersionId String        @map("form_version_id") @db.Uuid
  resultKey     String        @map("result_key") // e.g. PURCHASES_WITH_CREDIT.GROSS
  formFieldId   String?       @map("form_field_id") @db.Uuid
  method        MappingMethod @default(ATTRIBUTES)
  reason        String // explanation shown to the user
  confidence    Decimal?      @db.Decimal(3, 2) // only when method = AI
  createdAt     DateTime      @default(now()) @map("created_at")

  formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  formField   FormField?  @relation(fields: [formFieldId], references: [id], onDelete: SetNull)

  @@id([formVersionId, resultKey])
  @@unique([formVersionId, formFieldId])
  @@map("result_mappings")
}

enum MappingMethod {
  ATTRIBUTES
  AI
}

/// What the domain layer computed. Knows nothing about form fields --
/// the presentation layer joins this with the version's result_mappings
/// saved on tax_periods.
model PeriodResult {
  taxPeriodId String   @map("tax_period_id") @db.Uuid
  resultKey   String   @map("result_key")
  value       Decimal  @db.Decimal(14, 4) // 4 decimals for the factor (1.0000)
  computedAt  DateTime @default(now()) @map("computed_at")

  taxPeriod TaxPeriod @relation(fields: [taxPeriodId], references: [id], onDelete: Cascade)

  @@id([taxPeriodId, resultKey])
  @@map("period_results")
}

/// AI usage measurement to detect abuse, not for billing (ADR-007).
model AiUsage {
  userId       String   @map("user_id") @db.Uuid
  taxpayerId   String   @map("taxpayer_id") @db.Uuid
  period       DateTime @db.Date
  calls        Int      @default(0)
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taxpayer Taxpayer @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)

  @@id([userId, taxpayerId, period])
  @@map("ai_usage")
}
