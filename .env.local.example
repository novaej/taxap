# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://taxap:taxap_dev_password@localhost:5432/taxap_dev?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# AI classification (ADR-005 level 3, ADR-007 "no-AI mode"). Optional: with
# no key for the selected provider, the cascade falls through to manual
# review and nothing else breaks.
AI_PROVIDER="claude"          # "claude" | "openai"
ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."
# OPENAI_BULK_MODEL="gpt-4o-mini"      # only read when AI_PROVIDER=openai
# OPENAI_ESCALATION_MODEL="gpt-4o"     # only read when AI_PROVIDER=openai

# Storage (for form PDFs, if any)
# STORAGE_DRIVER="local|s3"
