# ─── Base de datos ───────────────────────────────────────────────────────────
# El usuario NO debe ser superusuario de PostgreSQL: los superusuarios ignoran
# la Row-Level Security incondicionalmente, incluso con FORCE. Ver ADR-004.
DATABASE_URL="postgresql://taxap:taxap_dev_password@localhost:5432/taxap_dev?schema=public&connection_limit=10"

# Solo en producción, con certificado gestionado:
# DATABASE_SSL=true
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ─── Autenticación ───────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ─── IA (opcional) ───────────────────────────────────────────────────────────
# Sin clave, el nivel 3 de la cascada queda inactivo y el sistema funciona en
# modo sin IA. Ver ADR-007.
ANTHROPIC_API_KEY=""
AI_CLASSIFICATION_MODEL="claude-haiku-4-5"
AI_ESCALATION_MODEL="claude-opus-5"
# Umbral por debajo del cual un veredicto va a la bandeja en vez de aplicarse
AI_CONFIDENCE_THRESHOLD="0.80"
# Usar Batch API para el pase masivo (50% menos costo, minutos en vez de segundos)
AI_USE_BATCH="true"

# ─── Almacenamiento de archivos originales ───────────────────────────────────
STORAGE_DRIVER="filesystem"   # filesystem | s3
STORAGE_PATH="./storage"
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ─── Observabilidad ──────────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ─── Aplicación ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEFAULT_LOCALE="es"
